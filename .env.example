# Copy to .env and adjust. Note: nothing loads .env automatically yet;
# export these in your shell (e.g. `set -a; source .env; set +a`).

APP_ENV=development
PORT=8080

# DB
DATABASE_URL="host=0.0.0.0 user=postgres password=postgres dbname=taskforge port=45432 sslmode=disable"

# Auth
# Required outside development. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=24h

# Worker pool
WORKER_COUNT=4
WORKER_POLL_INTERVAL=1s
